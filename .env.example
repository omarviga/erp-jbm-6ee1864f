# Copia este archivo a .env para desarrollo local.
# En producción define las mismas variables en el panel de tu hosting
# (Vercel → Settings → Environment Variables) y reconstruye: las variables
# VITE_* se incluyen al compilar, no se leen en tiempo de ejecución.
VITE_SUPABASE_URL="https://xxxx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="tu-clave-publicable"
# Alternativa legacy aceptada si aún no tienes publishable key:
# VITE_SUPABASE_ANON_KEY="tu-anon-key"
VITE_ALLOW_INVENTORY_FALLBACK=true
