# Normalizar line endings a LF en todo el repo
* text=auto eol=lf

# Archivos binarios (no tocar)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary

# Archivos que siempre son LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Scripts de Windows deben mantener CRLF si algún día se usan
*.bat  text eol=crlf
*.cmd  text eol=crlf
